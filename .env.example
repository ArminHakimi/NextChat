# Copy to .env.local and fill in to enable calls across restrictive networks.

# Optional comma-separated STUN servers (defaults to Google's public STUN server).
STUN_URLS=

# TURN relay used when peers cannot connect directly (strict NATs, mobile networks).
# Example: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=turn-nextphonecall.duckdns.org
TURN_USERNAME=
TURN_CREDENTIAL=
